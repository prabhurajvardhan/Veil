# VEIL Environment Configuration
# No mandatory environment variables required for local development viewer.

# M03 Visual Grounding — Hugging Face Hosted Inference (Prototype Backend)
# Hugging Face API user token for ShowUI-2B / VLM inference requests
HF_TOKEN=
# Optional custom Hugging Face inference endpoint URL (default: https://router.huggingface.co/hf-inference/models/showlab/ShowUI-2B)
HF_INFERENCE_ENDPOINT=
# Optional model name override (default: showlab/ShowUI-2B)
HF_MODEL_NAME=
